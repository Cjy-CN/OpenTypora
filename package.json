{
  "name": "opentypora",
  "version": "0.1.0",
  "private": true,
  "description": "A local Markdown editor with a shared source document model",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:desktop": "electron . --smoke-test",
    "build": "npm run typecheck && vite build && node scripts/build-desktop.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "electron .",
    "package": "npm run build && electron-builder --win portable --publish never"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-markdown": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/language-data": "^6.0.0",
    "@codemirror/search": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.43.13",
    "dompurify": "^3.0.0",
    "highlight.js": "^11.0.0",
    "iconv-lite": "^0.7.0",
    "katex": "^0.16.0",
    "markdown-it": "15.0.2",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.0.0",
    "mermaid": "^11.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "^2.0.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.0",
    "@types/markdown-it": "^14.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.0",
    "jsdom": "^29.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "build": {
    "appId": "org.opentypora.desktop",
    "productName": "OpenTypora",
    "directories": { "output": "release" },
    "files": ["dist/**", "dist-electron/**", "package.json"],
    "win": { "target": "portable", "signAndEditExecutable": false }
  }
}
